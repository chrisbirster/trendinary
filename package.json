{
  "name": "trendinary",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "go run ./cmd/trendinary",
    "typecheck": "tsc --noEmit",
    "test:go": "go test ./...",
    "build:web": "vite build",
    "build:server": "go build ./cmd/trendinary",
    "build": "npm run build:web && npm run build:server",
    "verify": "npm run typecheck && npm run test:go && npm run build",
    "deploy:fly": "fly deploy",
    "infra:diff": "sst diff --stage production",
    "infra:deploy": "sst deploy --stage production"
  },
  "dependencies": {
    "@solidjs/router": "2.0.0-next.17",
    "@solidjs/web": "2.0.0-rc.1",
    "@stylexjs/stylex": "0.19.0",
    "solid-js": "2.0.0-rc.1"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.29",
    "@stylexjs/unplugin": "0.19.0",
    "sst": "4.17.1",
    "typescript": "5.9.2",
    "vite": "8.2.1"
  }
}
